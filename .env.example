# Copy to .env and load it (or export these) before starting the app.

# --- required in production --------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | raspi-prod   (raspi-prod refuses to start without SECRET_KEY)
APP_ENV=development

# --- server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
# Serve over TLS by pointing at a certificate pair, or SSL_ADHOC=true for a
# self-signed one during testing.
# SSL_CERT=/etc/ssl/certs/shelflife.pem
# SSL_KEY=/etc/ssl/private/shelflife.key
# SSL_ADHOC=false

# --- storage -----------------------------------------------------------------
DATABASE_FILE=database.db
MAX_UPLOAD_MB=8
READING_RETENTION_DAYS=30

# --- sensing -----------------------------------------------------------------
# auto      : use live device readings when a device reported recently,
#             otherwise fall back to the clearly-labelled simulator
# live      : never simulate; show "offline" when the hardware is silent
# simulated : always simulate (demos and UI work)
SENSOR_SOURCE=auto
DEVICE_ONLINE_SECONDS=120
SIMULATOR_INTERVAL_SECONDS=30

# --- inference ---------------------------------------------------------------
# These default to the standard project layout, so simply dropping the artifacts
# into models/ and artifacts/ is enough. Override only to relocate them.
# KERAS_MODEL_PATH=models/best_multimodal_model.keras
# SCALER_PATH=artifacts/sensor_scaler.pkl
# MODEL_CONFIG_PATH=artifacts/config.json

# Held-out split metadata, used by the admin evaluation console only.
# DATASET_SPLITS_PATH=artifacts/dataset_splits.csv
# DATASET_IMAGE_DIR=data/Images

# Optional TFLite export for the Raspberry Pi deployment path.
# MODEL_PATH=models/shelflife.tflite
# MODEL_LABELS_PATH=models/shelflife.labels.json

# --- security ----------------------------------------------------------------
SESSION_DAYS=14
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300
# SESSION_COOKIE_SECURE=true   # defaults to true under APP_ENV=raspi-prod
# FORCE_HTTPS=true
