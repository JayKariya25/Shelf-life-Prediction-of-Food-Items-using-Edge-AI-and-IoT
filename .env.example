# Copy to .env and load it (or export these) before starting the app.

# --- required in production --------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | raspi-prod   (raspi-prod refuses to start without SECRET_KEY)
APP_ENV=development

# --- server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
# Serve over TLS by pointing at a certificate pair, or SSL_ADHOC=true for a
# self-signed one during testing.
# SSL_CERT=/etc/ssl/certs/shelflife.pem
# SSL_KEY=/etc/ssl/private/shelflife.key
# SSL_ADHOC=false

# --- storage -----------------------------------------------------------------
DATABASE_FILE=database.db
MAX_UPLOAD_MB=8
READING_RETENTION_DAYS=30

# --- sensing -----------------------------------------------------------------
# auto      : use live device readings when a device reported recently,
#             otherwise fall back to the clearly-labelled simulator
# live      : never simulate; show "offline" when the hardware is silent
# simulated : always simulate (demos and UI work)
SENSOR_SOURCE=auto
DEVICE_ONLINE_SECONDS=300
# How often devices are asked to report. The model was trained on 2-minute readings.
DEVICE_REPORT_INTERVAL_SECONDS=120

# --- the trained shelf-life model -------------------------------------------
# The bundle produced by the training pipeline. Leave as-is unless you move it.
# RSL_BUNDLE_DIR=ml/rsl_multimodal
# RSL_MODEL_FILE=models/image_ensemble_blocked_full_float16.tflite
# The older two-input export is still in the bundle and still loadable, if you want to
# compare: models/fusion_blocked_full_float16.tflite. It scores worse on an unseen day
# (1.17 d against 0.85 d) and needs a gas reading, which is why it is not the default.
# A tracked item uses the trained model only with a photo this recent.
RSL_MAX_PHOTO_AGE_HOURS=6
# The produce the trained model was actually fitted on; everything else uses the kinetic
# baseline. The dataset is a single banana run, so widening this without retraining would
# make the site report a banana model's number for another food.
RSL_TRAINED_FOOD_KEYS=banana

# --- real ambient conditions --------------------------------------------------
# With SENSOR_SOURCE=auto and no device reporting, the site shows the real current
# weather for this point instead of the built-in simulator. Needs no API key
# (Open-Meteo). Set it to wherever the food actually is; the default is PES
# University, Bengaluru. Turn it off to keep the machine entirely offline.
WEATHER_ENABLED=true
WEATHER_LATITUDE=12.9344
WEATHER_LONGITUDE=77.5353
WEATHER_PLACE=Bengaluru
# One fetch per interval, shared by every request. A page load never waits longer
# than WEATHER_TIMEOUT_SECONDS; on failure the simulator takes over, clearly labelled.
WEATHER_TTL_SECONDS=600
WEATHER_TIMEOUT_SECONDS=4
# Faster device streams are thinned to this spacing before features are built.
RSL_MIN_READING_SPACING_SECONDS=90

# --- security ----------------------------------------------------------------
SESSION_DAYS=14
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300
# SESSION_COOKIE_SECURE=true   # defaults to true under APP_ENV=raspi-prod
# FORCE_HTTPS=true
